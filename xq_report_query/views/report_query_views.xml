<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_query_wizard_form" model="ir.ui.view">
        <field name="name">xq.report.query.wizard.form</field>
        <field name="model">xq.report.query.wizard</field>
        <field name="arch" type="xml">
            <form string="报表查询">
                <header>
                    <button name="action_query" type="object" string="查询" class="oe_highlight" icon="fa-search"/>
                    <button name="action_export_xlsx" type="object" string="导出 Excel" icon="fa-download"/>
                </header>
                <sheet>
                    <group string="查询条件" col="4">
                        <field name="report_type"/>
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="warehouse_id"/>
                        <field name="product_categ_id"/>
                        <field name="product_id"/>
                        <field name="lot_keyword" placeholder="按批次号包含关键字过滤"/>
                    </group>
                    <group>
                        <field name="result_count" readonly="1"/>
                        <field name="file_name" readonly="1" invisible="1"/>
                        <field name="file_data" readonly="1" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="生产报表" invisible="report_type != 'production'">
                            <field name="production_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="report_date"/>
                                    <field name="product_name"/>
                                    <field name="base_film_name"/>
                                    <field name="thickness"/>
                                    <field name="width"/>
                                    <field name="raw_lot_name"/>
                                    <field name="finished_lot_name"/>
                                    <field name="planned_meters"/>
                                    <field name="actual_meters"/>
                                    <field name="area_sqm"/>
                                    <field name="yield_rate"/>
                                    <field name="quality_note"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                        <page string="现有成品库存" invisible="report_type != 'finished_stock'">
                            <field name="finished_stock_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="product_name"/>
                                    <field name="thickness"/>
                                    <field name="width"/>
                                    <field name="meters"/>
                                    <field name="lot_name"/>
                                    <field name="stock_quantity"/>
                                    <field name="quantity"/>
                                    <field name="net_weight_ton"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                        <page string="原膜汇总" invisible="report_type != 'raw_film_incoming'">
                            <field name="raw_film_incoming_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="arrival_date"/>
                                    <field name="product_name"/>
                                    <field name="thickness"/>
                                    <field name="width"/>
                                    <field name="meters"/>
                                    <field name="grade"/>
                                    <field name="lot_name"/>
                                    <field name="product_condition"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                        <page string="现有原膜库存" invisible="report_type != 'raw_film_stock'">
                            <field name="raw_film_stock_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="arrival_date"/>
                                    <field name="product_name"/>
                                    <field name="thickness"/>
                                    <field name="width"/>
                                    <field name="meters"/>
                                    <field name="grade"/>
                                    <field name="lot_name"/>
                                    <field name="product_condition"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                        <page string="原液来料" invisible="report_type != 'solution_incoming'">
                            <field name="solution_incoming_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="arrival_date"/>
                                    <field name="product_name"/>
                                    <field name="quantity_kg"/>
                                    <field name="lot_name"/>
                                    <field name="supplier_name"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                        <page string="现有涂液库存" invisible="report_type != 'coating_stock'">
                            <field name="coating_stock_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="arrival_date"/>
                                    <field name="product_name"/>
                                    <field name="quantity_kg"/>
                                    <field name="lot_name"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_query_wizard" model="ir.actions.act_window">
        <field name="name">报表查询</field>
        <field name="res_model">xq.report.query.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_report_query_wizard_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_report_query_root" name="报表查询" sequence="80" groups="base.group_user"/>
    <menuitem id="menu_report_query" name="生产与库存报表" parent="menu_report_query_root" action="action_report_query_wizard" sequence="10" groups="base.group_user"/>
</odoo>
