<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 确保批次号字段可以手动修改 -->
    <record id="view_production_form_auto_lot_generate" model="ir.ui.view">
        <field name="name">mrp.production.form.auto.lot.generate</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='lot_producing_id']" position="replace">
                <label for="mrp_auto_lot_name" invisible="state == 'draft' or product_tracking in ('none', False)"/>
            </xpath>
            <xpath expr="//field[@name='lot_producing_id']" position="replace">
                <field name="lot_producing_id"
                       invisible="1"
                       required="0"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                       context="{'default_product_id': product_id, 'default_company_id': company_id, 'default_production_id': id, 'production_id': id}"/>
                <field name="mrp_auto_lot_name"
                       readonly="not lot_producing_id"
                       placeholder="点击右侧按钮生成"/>
            </xpath>
        </field>
    </record>
</odoo>
