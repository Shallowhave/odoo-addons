<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp.auto.lot.generate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <block title="生产自动批次生成器" id="mrp_auto_lot_generate_settings">
                    <setting id="mrp_auto_lot_batch_prefix_setting" string="批次号前缀" help="配置自动生成批次号的前缀">
                        <field name="mrp_auto_lot_batch_prefix"/>
                        <div class="text-muted">
                            默认为 'XQ'。格式为：{PREFIX}YYMMDDHHMMAxx[-X]
                        </div>
                    </setting>
                    <setting id="mrp_auto_lot_prefix_date_only_setting" string="只生成前缀和日期" help="启用后只自动生成前缀和日期，后续由业务人员手动填写">
                        <field name="mrp_auto_lot_prefix_date_only"/>
                        <div class="text-muted">
                            启用后生成格式为：{PREFIX}YYMMDD，例如 XQ260629。该占位批次号和补全后的批次号都不能重复。
                        </div>
                    </setting>
                    <setting id="mrp_auto_lot_logging_setting" string="启用详细日志" help="启用批次生成过程的详细日志记录">
                        <field name="mrp_auto_lot_enable_logging"/>
                    </setting>
                    <setting id="mrp_auto_lot_override_generate_serial_setting" string="覆盖原生批次号生成" help="启用后，点击创建新序列号/批号按钮时将使用自定义批次号格式">
                        <field name="mrp_auto_lot_override_generate_serial"/>
                        <div class="text-muted">
                            默认启用。启用后使用自定义格式（如：XQ2511261421A10），关闭后使用 Odoo 原生格式。
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
