<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_freeform_metadata" model="ir.ui.view">
        <field name="name">stock.picking.form.freeform.metadata</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group/field[@name='origin']" position="after">
                <field name="is_freeform_quant_delivery" readonly="1"
                       groups="stock.group_stock_manager"/>
                <field name="freeform_customer_id" readonly="1"
                       groups="stock.group_stock_manager"/>
                <field name="freeform_request_token" readonly="1"
                       groups="stock.group_stock_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
