<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_rfid_user" model="res.groups">
        <field name="name">RFID User</field>
    </record>

    <record id="group_rfid_manager" model="res.groups">
        <field name="name">RFID Manager</field>
        <field name="implied_ids" eval="[(4, ref('xq_rfid.group_rfid_user'))]"/>
    </record>

    <record id="rfid_tag_company_rule" model="ir.rule">
        <field name="name">RFID tags: allowed companies</field>
        <field name="model_id" ref="model_rfid_tag"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('xq_rfid.group_rfid_user'))]"/>
    </record>

    <record id="rfid_device_company_rule" model="ir.rule">
        <field name="name">RFID devices: allowed companies</field>
        <field name="model_id" ref="model_rfid_device_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('xq_rfid.group_rfid_user'))]"/>
    </record>
</odoo>
